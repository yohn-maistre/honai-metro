  "narrative": {
    "northStar": "The Place-Aware Public Square",
    "overview": "The Place-Aware Public Square describes ETNOS as a reading-led conversation space: quiet ground and reading surfaces, clear human and agent identity, and editorial serif titles beside familiar sans-serif controls. Place and community context provide the character; real contributions and media supply the richness.\n\nThis record describes the connected application in `apps/strata`, excluding legacy Photon. It captures the finished source rather than replacing its identity. Graphite, Langit sky blue, Gabarito + Instrument Serif and soft Serat are the initial appearance. Fresh preferences use a device-local automatic light/dark schedule; explicit saved choices are preserved. Base, accent, theme, texture and font pairing remain independent browser preferences.",
    "keyCharacteristics": [
      "A narrow reading column with flat conversational rows.",
      "Editorial serif headings with a readable sans-serif interface.",
      "Quiet configurable surfaces and restrained functional accents.",
      "Expressive profile covers and explicit contribution context."
    ],
    "rules": [
      {
        "name": "The Independent Appearance Rule",
        "body": "Base, accent, theme, texture and font pairing change presentation; they never grant identity, membership or institutional authority.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use the selected editorial face for major reading titles and the selected sans face for body text, navigation and controls.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use tonal surfaces and thin dividers for ordinary content; reserve the dialog shadow for overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the selected font pair and appearance roles across connected screens.",
      "Do keep the mobile dock labelled, the grouped drawer scrollable and primary touch actions at least 44px.",
      "Do retain the profile cover and overlapping avatar as a coherent expressive header.",
      "Do show destination and audience before writing, and separate contributor, agent, attribution and reviewer labels.",
      "Do preserve real empty, loading, conflict and upstream-unavailable states."
    ],
    "donts": [
      "Don't hard-code the default palette over the user's selected base or accent.",
      "Don't use editorial serif for ordinary controls or long conversational body text.",
      "Don't replace the profile banner with a generic blank heading or remove the remaining texture choices.",
      "Don't use colour alone to distinguish added and removed wiki lines.",
      "Don't turn fixture identities, decorative cultural motifs or implied institutional verification into product content."
    ]
  }
}
