      "css": ".ds-button-primary{font-family:var(--font-sans,'Gabarito Variable',sans-serif);font-size:14px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border:1px solid transparent;border-radius:10px;cursor:pointer;transition:background-color 140ms ease,transform 100ms ease;background:var(--foreground,#f5f5f5);color:var(--background,#171717)}.ds-button-primary:hover{background:color-mix(in srgb,var(--foreground,#f5f5f5) 80%,transparent)}.ds-button-primary:focus-visible{outline:none;border-color:var(--brand,#3e96fb);box-shadow:0 0 0 3px color-mix(in srgb,var(--brand,#3e96fb) 50%,transparent)}.ds-button-primary:active{transform:translateY(1px)}.ds-button-primary:disabled{opacity:.5;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
